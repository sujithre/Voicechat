# ---- Microsoft Foundry / Voice Live ----
# Foundry resource endpoint (NOT the project endpoint). Example:
#   https://my-foundry-resource.services.ai.azure.com
VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com

# Voice Live API version.
VOICELIVE_API_VERSION=2025-10-01

# ---- Foundry agent to invoke ----
# The Foundry project name (last segment of your project endpoint).
AGENT_PROJECT_NAME=<your-project-name>

# The agent to talk to (as shown in the Foundry portal).
AGENT_NAME=novartis-quarterly
# Optional: pin a published version. Leave blank for latest.
AGENT_VERSION=

# Query-parameter style for agent mode:
#   new     -> agent-name / agent-project-name / agent-version   (Foundry Agent Service)
#   classic -> agent-id  / agent-project-name / agent-access-token (Agent Service classic)
AGENT_PARAM_STYLE=new

# Only used when AGENT_PARAM_STYLE=classic
AGENT_ID=

# ---- Voice ----
VOICE_NAME=en-US-Ava:DragonHDLatestNeural
VOICE_TYPE=azure-standard
VOICE_TEMPERATURE=0.8

# ---- Avatar ----
# photo | video | none
AVATAR_KIND=photo
# Photo avatars: adrian, amara, amira, anika, bianca, camila, carlos, clara,
# darius, diego, elise, farhan, faris, gabrielle, hyejin, imran, isabella,
# layla, liwei, ling, marcus, matteo, rahul, rana, ren, riya, sakura, simone,
# zayd, zoe.
# Video avatars: lisa (style casual-sitting), harry (style casual), meg, max, ...
AVATAR_CHARACTER=camila
AVATAR_STYLE=
AVATAR_CUSTOMIZED=false
# #RRGGBBAA. The alpha byte is ignored for real-time avatar, so there is no
# transparency -- use "#000000FF" for additive displays (LED fan, Pepper's ghost),
# where black emits no light and therefore reads as invisible.
# Must be quoted: dotenv reads a bare leading # as a comment.
AVATAR_BACKGROUND_COLOR=
AVATAR_BACKGROUND_IMAGE_URL=

# How avatar media reaches the browser.
#   webrtc    - direct browser <-> Azure TURN relay. Lowest latency, but needs
#               outbound UDP 3478 / TCP 443 to relay.communication.microsoft.com
#               from every client network.
#   websocket - muxed into this app's WebSocket as fragmented MP4. No firewall
#               changes and stays inside your VNet, at the cost of ~200-400ms
#               extra latency and no iOS Safari support.
AVATAR_OUTPUT=webrtc

# ---- Conversation ----
TURN_DETECTION_TYPE=azure_semantic_vad
GREET_ON_CONNECT=true

# Exact opening line. Leave blank and the agent composes its own, which comes
# out differently every session -- set this for a scripted event.
GREETING_TEXT=

# How long the caller must stop talking before the turn is sent. This is dead
# air on every turn, so it is the one part of response latency you control.
# Raise towards 500 if callers are cut off mid-sentence.
VAD_SILENCE_MS=300

# Spoken filler while the agent is thinking. Doesn't reduce latency, but removes
# the dead air that makes it noticeable.
#   off    - disabled (default)
#   static - speaks one of INTERIM_RESPONSE_TEXTS at random
#   llm    - generates a contextual filler with INTERIM_RESPONSE_MODEL
INTERIM_RESPONSE=off
# Below about 1500 the filler fires on turns the agent would have answered
# promptly anyway, which sounds worse than the pause it replaces.
INTERIM_RESPONSE_THRESHOLD_MS=1500
INTERIM_RESPONSE_TRIGGERS=latency
INTERIM_RESPONSE_TEXTS=Let me check that.|One moment.|Let me look that up.|Give me a second.
INTERIM_RESPONSE_MODEL=gpt-4.1-mini
INTERIM_RESPONSE_INSTRUCTIONS=
INTERIM_RESPONSE_MAX_TOKENS=50

# ---- Presentation ----
# Shown in the browser instead of the agent and project names. Leave blank to
# fall back to AGENT_NAME.
DISPLAY_TITLE=
DISPLAY_SUBTITLE=

# ---- Server ----
PORT=3000
# Comma-separated list of extra allowed browser origins (the app's own origin is
# always allowed). Used to block cross-site WebSocket hijacking.
ALLOWED_ORIGINS=

# ---- Local development only ----
# Leave blank in Azure: the App Service managed identity is used instead.
# AZURE_CLIENT_ID=
